.nafbar {
  width: 100%;
  height: 70px;
  background-color: #faede8;
}
.nafbar .navLift {
  width: 808px;
  height: 44px;
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-top: 20px;
}
.nafbar .navright {
  width: 380px;
  height: 44px;
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-top: 20px;
}
.nafbar a {
  text-decoration: none;
  color: black;
  font-size: 20px;
}

